# Environment variables for DengueCast
# Copy to .env and fill in values. Never commit .env to git.

# Optional: override config file path
# DENGUECAST_CONFIG=config/default.yaml

# Optional: logging level
# DENGUECAST_LOG_LEVEL=INFO

# Optional: NASA POWER API (only needed for nasa_power adapter)
# NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# Optional: set to 0 to disable synthetic mode
# DENGUECAST_SYNTHETIC=1
